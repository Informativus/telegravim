{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/telegravim/local-data/v1",
  "title": "Telegravim local data module envelope",
  "type": "object",
  "required": ["module_id", "schema_version"],
  "properties": {
    "module_id": {"type": "string", "pattern": "^[a-z0-9_]{1,96}$"},
    "schema_version": {"type": "integer", "minimum": 1, "maximum": 2147483647}
  },
  "additionalProperties": true,
  "allOf": [{
    "if": {
      "properties": {"module_id": {"const": "saved_tags"}, "schema_version": {"enum": [1, 2]}},
      "required": ["module_id", "schema_version"]
    },
    "then": {
      "required": ["records"],
      "properties": {"records": {"type": "array", "maxItems": 1000000, "items": {"$ref": "#/$defs/savedRecord"}}}
    }
  }, {
    "if": {
      "properties": {"module_id": {"const": "navigation_preferences"}, "schema_version": {"const": 1}},
      "required": ["module_id", "schema_version"]
    },
    "then": {
      "required": ["records"],
      "properties": {"records": {"type": "array", "maxItems": 1000000, "items": {"$ref": "#/$defs/navigationRecord"}}}
    }
  }, {
    "if": {
      "properties": {"module_id": {"const": "pinned_items"}, "schema_version": {"const": 1}},
      "required": ["module_id", "schema_version"]
    },
    "then": {
      "required": ["records"],
      "properties": {"records": {"type": "array", "maxItems": 1000000, "items": {"$ref": "#/$defs/pinnedRecord"}}}
    }
  }, {
    "if": {
      "properties": {"module_id": {"const": "chat_folders"}, "schema_version": {"const": 1}},
      "required": ["module_id", "schema_version"]
    },
    "then": {
      "required": ["records"],
      "properties": {"records": {"type": "array", "maxItems": 1000000, "items": {"$ref": "#/$defs/chatFolderRecord"}}}
    }
  }, {
    "if": {
      "properties": {
        "module_id": {
          "const": "quick_replies"
        },
        "schema_version": {
          "const": 1
        }
      },
      "required": [
        "module_id",
        "schema_version"
      ]
    },
    "then": {
      "required": [
        "records"
      ],
      "properties": {
        "records": {
          "type": "array",
          "maxItems": 1000000,
          "items": {
            "$ref": "#/$defs/quickReplyRecord"
          }
        }
      }
    }
  }],
  "$defs": {
    "quickReplyStickerSetHints": {
      "type": "object",
      "description": "Optional hints keyed by attached_stickers document ID; all IDs are canonical positive uint64 decimal strings and each key must occur in the unchanged attached_stickers array. Runtime validation enforces the uint64 maximum and sibling membership.",
      "maxProperties": 1024,
      "propertyNames": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
          "short_name": { "type": "string", "pattern": "^[A-Za-z0-9_]{1,64}$" }
        },
        "anyOf": [ { "required": ["id"] }, { "required": ["short_name"] } ],
        "additionalProperties": true
      }
    },
    "quickReplyMediaHints": {
      "properties": {
        "attached_sticker_sets": { "$ref": "#/$defs/quickReplyStickerSetHints" },
        "cover_asset_media": { "$ref": "#/$defs/quickReplyMediaHints" },
        "photo_asset_media": { "$ref": "#/$defs/quickReplyMediaHints" },
        "document_asset_media": { "$ref": "#/$defs/quickReplyMediaHints" },
        "rich_assets": {
          "items": {
            "properties": { "media": { "$ref": "#/$defs/quickReplyMediaHints" } }
          }
        }
      }
    },
    "quickReplyDraftText": {
      "type": "object",
      "required": [
        "text",
        "tags"
      ],
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 32768
        },
        "tags": {
          "type": "array",
          "maxItems": 32768,
          "items": {
            "type": "object",
            "required": [
              "offset",
              "length",
              "id"
            ],
            "properties": {
              "offset": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              },
              "length": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              },
              "id": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "quickReplyEditorDraft": {
      "allOf": [
        {
          "$ref": "#/$defs/quickReplyDraftText"
        },
        {
          "type": "object",
          "required": [
            "message_ref",
            "quote",
            "quote_offset",
            "cursor",
            "webpage"
          ],
          "properties": {
            "message_ref": {
              "anyOf": [
                {
                  "$ref": "#/$defs/uuid"
                },
                {
                  "type": "null"
                }
              ]
            },
            "source_version_vector": {
              "description": "Original edited message revision; replaced atomically. Missing or null requires text recovery, unless the legacy parent baseline is present.",
              "anyOf": [
                { "$ref": "#/$defs/versionVector" },
                { "type": "null" }
              ]
            },
            "source_legacy_parent_version_vector": {
              "description": "Original parent revision for an unmigrated legacy message; mutually exclusive with a message revision.",
              "anyOf": [
                { "$ref": "#/$defs/versionVector" },
                { "type": "null" }
              ]
            },
            "quote": {
              "$ref": "#/$defs/quickReplyDraftText"
            },
            "quote_offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 32768
            },
            "cursor": {
              "type": "object",
              "required": [
                "position",
                "anchor",
                "scroll"
              ],
              "properties": {
                "position": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647
                },
                "anchor": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647
                },
                "scroll": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647
                }
              },
              "additionalProperties": true
            },
            "webpage": {
              "type": "object",
              "required": [
                "url",
                "large",
                "small",
                "invert",
                "manual",
                "removed"
              ],
              "properties": {
                "url": {
                  "type": "string"
                },
                "large": {
                  "type": "boolean"
                },
                "small": {
                  "type": "boolean"
                },
                "invert": {
                  "type": "boolean"
                },
                "manual": {
                  "type": "boolean"
                },
                "removed": {
                  "type": "boolean"
                }
              },
              "additionalProperties": true
            }
          },
          "not": {
            "required": ["source_version_vector", "source_legacy_parent_version_vector"],
            "properties": {
              "source_version_vector": { "type": "object" },
              "source_legacy_parent_version_vector": { "type": "object" }
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "quickReplyRecord": {
      "allOf": [
        {
          "$ref": "#/$defs/record"
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "reply"
              },
              "deleted": {
                "const": false
              }
            },
            "required": [
              "kind",
              "deleted"
            ]
          },
          "then": {
            "required": [
              "title",
              "shortcut",
              "category",
              "text",
              "entities",
              "variables",
              "attachments",
              "position"
            ],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "shortcut": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "category": {
                "type": "string",
                "maxLength": 128
              },
              "text": {
                "type": "string",
                "maxLength": 32768
              },
              "entities": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "type",
                    "offset",
                    "length",
                    "data"
                  ],
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "offset": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "length": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "data": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true
                }
              },
              "variables": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "default"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 32
                    },
                    "default": {
                      "type": "string",
                      "maxLength": 32768
                    }
                  },
                  "additionalProperties": true
                }
              },
              "attachments": {
                "type": "array",
                "maxItems": 10,
                "items": {
                  "type": "object",
                  "required": [
                    "sha256",
                    "size",
                    "filename",
                    "mime"
                  ],
                  "properties": {
                    "sha256": {
                      "$ref": "#/$defs/sha256"
                    },
                    "size": {
                      "type": "string",
                      "pattern": "^(0|[1-9][0-9]{0,18})$"
                    },
                    "filename": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 255,
                      "pattern": "^[^/\\\\]+$",
                      "not": {
                        "enum": [
                          ".",
                          ".."
                        ]
                      }
                    },
                    "mime": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true
                }
              },
              "position": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              }
            },
            "additionalProperties": true
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "message"
              },
              "deleted": {
                "const": false
              }
            },
            "required": [
              "kind",
              "deleted"
            ]
          },
          "then": {
            "required": [
              "reply_ref",
              "text",
              "entities",
              "attachments",
              "position",
              "media"
            ],
            "properties": {
              "text": {
                "type": "string",
                "maxLength": 32768
              },
              "entities": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "type",
                    "offset",
                    "length",
                    "data"
                  ],
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "offset": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "length": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "data": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true
                }
              },
              "attachments": {
                "type": "array",
                "maxItems": 8192,
                "items": {
                  "type": "object",
                  "required": [
                    "sha256",
                    "size",
                    "filename",
                    "mime"
                  ],
                  "properties": {
                    "sha256": {
                      "$ref": "#/$defs/sha256"
                    },
                    "size": {
                      "type": "string",
                      "pattern": "^(0|[1-9][0-9]{0,18})$"
                    },
                    "filename": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 255,
                      "pattern": "^[^/\\\\]+$",
                      "not": {
                        "enum": [
                          ".",
                          ".."
                        ]
                      }
                    },
                    "mime": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true
                }
              },
              "position": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              },
              "reply_ref": {
                "$ref": "#/$defs/uuid"
              },
              "group_ref": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/uuid"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reply_to_ref": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/uuid"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "media": {
                "allOf": [ { "$ref": "#/$defs/quickReplyMediaHints" } ],
                "type": "object",
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "editor_draft"
              },
              "deleted": {
                "const": false
              }
            },
            "required": [
              "kind",
              "deleted"
            ]
          },
          "then": {
            "required": [
              "reply_ref"
            ],
            "properties": {
              "reply_ref": {
                "$ref": "#/$defs/uuid"
              },
              "normal": {
                "$ref": "#/$defs/quickReplyEditorDraft"
              },
              "edit": {
                "$ref": "#/$defs/quickReplyEditorDraft"
              }
            },
            "additionalProperties": true
          }
        }
      ]
    },
    "uuid": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "decimalId": {"type": "string", "pattern": "^[1-9][0-9]{0,19}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "account": {
      "type": "object",
      "required": ["environment", "user_id"],
      "properties": {
        "environment": {"enum": ["production", "test"]},
        "user_id": {"$ref": "#/$defs/decimalId"}
      },
      "additionalProperties": true
    },
    "accountFile": {
      "allOf": [{"$ref": "#/$defs/account"}],
      "required": ["profile_id", "extra"],
      "properties": {
        "profile_id": {"$ref": "#/$defs/uuid"},
        "extra": {"type": "object"},
        "retained_transfer": {
          "type": "object",
          "propertyNames": {"not": {"enum": ["account", "profile", "modules", "files"]}},
          "additionalProperties": true
        }
      }
    },
    "versionVector": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 256,
      "propertyNames": {"$ref": "#/$defs/uuid"},
      "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
    },
    "record": {
      "type": "object",
      "required": ["id", "version_vector", "deleted"],
      "properties": {
        "id": {"$ref": "#/$defs/uuid"},
        "version_vector": {"$ref": "#/$defs/versionVector"},
        "deleted": {"type": "boolean"},
        "kind": {"type": "string"}
      },
      "additionalProperties": true
    },
    "nativeReaction": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "emoji"],
          "properties": {
            "kind": {"const": "emoji"},
            "emoji": {"type": "string", "minLength": 1, "maxLength": 32, "not": {"const": "*"}}
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": ["kind", "document_id"],
          "properties": {
            "kind": {"const": "custom"},
            "document_id": {"$ref": "#/$defs/decimalId"}
          },
          "additionalProperties": true
        }
      ]
    },
    "savedPeer": {
      "type": "object",
      "required": ["peer_type", "peer_id"],
      "properties": {
        "peer_type": {"enum": ["user", "chat", "channel"]},
        "peer_id": {"$ref": "#/$defs/decimalId"}
      },
      "additionalProperties": true
    },
    "pinnedScope": {
      "type": "string",
      "pattern": "^(main|archive|saved|local:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|filter:[1-9][0-9]{0,9}:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$"
    },
    "pinnedRecord": {
      "allOf": [
        {"$ref": "#/$defs/record"},
        {
          "if": {"properties": {"kind": {"const": "pin"}}, "required": ["kind"]},
          "then": {
            "required": ["scope", "peer"],
            "properties": {
              "scope": {"$ref": "#/$defs/pinnedScope"},
              "peer": {"$ref": "#/$defs/savedPeer"},
              "retained_order_peers": {"type": "array", "items": {"$ref": "#/$defs/savedPeer"}}
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "order"}}, "required": ["kind"]},
          "then": {
            "required": ["scope", "peers"],
            "properties": {
              "scope": {"$ref": "#/$defs/pinnedScope"},
              "peers": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/savedPeer"}}
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "filter"}}, "required": ["kind"]},
          "then": {
            "required": ["filter_id", "scope_id"],
            "properties": {
              "filter_id": {"type": "string", "pattern": "^[1-9][0-9]{0,9}$"},
              "scope_id": {"$ref": "#/$defs/uuid"}
            }
          }
        }
      ],
      "additionalProperties": true
    },
    "folderRule": {
      "type": "object",
      "additionalProperties": true
    },
    "chatFolderRecord": {
      "allOf": [
        {"$ref": "#/$defs/record"},
        {
          "if": {"properties": {"kind": {"const": "folder"}}, "required": ["kind"]},
          "then": {
            "required": ["folder_id", "title", "position", "rules"],
            "properties": {
              "folder_id": {"$ref": "#/$defs/uuid"},
              "title": {"type": "string", "minLength": 1, "maxLength": 100},
              "title_entities": {
                "type": "array", "maxItems": 128,
                "items": {
                  "type": "object",
                  "required": ["type", "offset", "length"],
                  "properties": {
                    "type": {"type": "string", "minLength": 1},
                    "offset": {"type": "integer", "minimum": 0, "maximum": 2147483647},
                    "length": {"type": "integer", "minimum": 1, "maximum": 2147483647},
                    "data": {"type": "string", "maxLength": 1024}
                  },
                  "additionalProperties": true
                }
              },
              "static_title": {"type": "boolean"},
              "icon": {"type": "string", "maxLength": 32},
              "color": {"type": "integer", "minimum": 0, "maximum": 255},
              "position": {"type": "integer", "minimum": 0, "maximum": 2147483647},
              "rules": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/folderRule"}}
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "member"}}, "required": ["kind"]},
          "then": {
            "required": ["folder_id", "peer", "mode"],
            "properties": {
              "folder_id": {"$ref": "#/$defs/uuid"},
              "peer": {"$ref": "#/$defs/savedPeer"},
              "mode": {"enum": ["include", "exclude"]}
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "settings"}}, "required": ["kind"]},
          "then": {
            "required": ["scope", "tags_enabled"],
            "properties": {
              "scope": {"const": "account"},
              "tags_enabled": {"type": "boolean"}
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "cloud_color"}}, "required": ["kind"]},
          "then": {
            "required": ["scope", "color_index"],
            "properties": {
              "scope": {"allOf": [{"$ref": "#/$defs/pinnedScope"}, {"pattern": "^filter:"}]},
              "color_index": {"type": ["integer", "null"], "minimum": 0, "maximum": 255}
            }
          }
        }
      ],
      "additionalProperties": true
    },
    "navigationReference": {
      "type": "string",
      "pattern": "^(all|local:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|filter:[1-9][0-9]{0,9}:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$"
    },
    "navigationRecord": {
      "allOf": [
        {"$ref": "#/$defs/record"},
        {
          "if": {"properties": {"kind": {"const": "settings"}}, "required": ["kind"]},
          "then": {
            "required": ["scope", "restore_last_section", "visible_order"],
            "properties": {
              "scope": {"const": "account"},
              "startup_ref": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/navigationReference"}]},
              "last_section_ref": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/navigationReference"}]},
              "restore_last_section": {"type": "boolean"},
              "visible_order": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/navigationReference"}}
            }
          }
        }
      ],
      "additionalProperties": true
    },
    "savedRecord": {
      "allOf": [
        {"$ref": "#/$defs/record"},
        {
          "if": {"properties": {"kind": {"const": "tag"}, "deleted": {"const": false}}, "required": ["kind", "deleted"]},
          "then": {
            "required": ["title", "emoji", "position"],
            "anyOf": [
              {"required": ["native_reaction"]},
              {"properties": {"title": {"minLength": 1}}}
            ],
            "properties": {
              "title": {"type": "string", "maxLength": 100},
              "emoji": {"type": "string", "maxLength": 32},
              "native_reaction": {"$ref": "#/$defs/nativeReaction"},
              "position": {"type": "integer", "minimum": 0, "maximum": 2147483647}
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "binding"}, "deleted": {"const": false}}, "required": ["kind", "deleted"]},
          "then": {
            "required": ["tag_id", "message"],
            "properties": {
              "tag_id": {"$ref": "#/$defs/uuid"},
              "message": {
                "type": "object",
                "required": ["peer_type", "peer_id", "message_id"],
                "properties": {
                  "peer_type": {"const": "user"},
                  "peer_id": {"$ref": "#/$defs/decimalId"},
                  "message_id": {"type": "string", "pattern": "^[1-9][0-9]{0,9}$"}
                },
                "additionalProperties": true
              },
              "source_text": {"type": "string", "maxLength": 32768},
              "source_hash": {"$ref": "#/$defs/sha256"},
              "saved_peer": {"$ref": "#/$defs/savedPeer"},
              "reaction_position": {"type": "integer", "minimum": 0, "maximum": 2147483647}
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "filter"}, "deleted": {"const": false}}, "required": ["kind", "deleted"]},
          "then": {
            "required": ["tags", "text"],
            "properties": {
              "tags": {"type": "array", "items": {"$ref": "#/$defs/uuid"}},
              "text": {"type": "string", "maxLength": 4096}
            }
          }
        }
      ]
    },
    "file": {
      "type": "object",
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "size": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": true
    },
    "manifest": {
      "type": "object",
      "required": ["format", "version", "package_id", "created_at", "device_id", "generation", "extra", "profiles", "assets", "files"],
      "properties": {
        "format": {"const": "telegravim-transfer"},
        "version": {"const": 1},
        "package_id": {"$ref": "#/$defs/uuid"},
        "created_at": {"type": "string", "format": "date-time"},
        "device_id": {"$ref": "#/$defs/uuid"},
        "generation": {"$ref": "#/$defs/uuid"},
        "extra": {"type": "object"},
        "retained_transfer": {
          "type": "object",
          "propertyNames": {"not": {"const": "manifest"}},
          "additionalProperties": true
        },
        "profiles": {
          "type": "array", "maxItems": 128,
          "items": {
            "type": "object", "required": ["profile_id", "account", "modules"],
            "properties": {
              "profile_id": {"$ref": "#/$defs/uuid"},
              "account": {"type": "string"},
              "modules": {
                "type": "array", "maxItems": 128,
                "items": {
                  "type": "object", "required": ["module_id", "path"],
                  "properties": {"module_id": {"type": "string", "pattern": "^[a-z0-9_]{1,96}$"}, "path": {"type": "string"}},
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": true
          }
        },
        "assets": {
          "type": "array", "maxItems": 100000,
          "items": {
            "type": "object", "required": ["sha256", "size", "extra"],
            "properties": {
              "sha256": {"$ref": "#/$defs/sha256"},
              "size": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
              "extra": {"type": "object"},
              "retained_transfer": {
                "type": "object",
                "propertyNames": {"not": {"enum": ["registry", "file"]}},
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          }
        },
        "files": {"type": "array", "maxItems": 116512, "items": {"$ref": "#/$defs/file"}}
      },
      "additionalProperties": true
    }
  }
}
