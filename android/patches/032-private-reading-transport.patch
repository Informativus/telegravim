+                    privateReadingError(500, "PRIVATE_READING_SERIALIZATION_FAILED"));
+            return requestToken;
+        }
+        Utilities.stageQueue.postRunnable(() -> sendPrivateReadingRequestInternal(request));
+        return requestToken;
+    }
