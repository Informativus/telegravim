+    private void sendPrivateReadingRequestInternal(final PrivateReadingRequest request) {
+        if (request.terminal.get()) {
+            return;
+        }
+        if (request.owner.account() != currentAccount || !request.owner.isCurrent()) {
+            completePrivateReadingRequest(request, null, privateReadingError(401,
+                    "PRIVATE_READING_ACCOUNT_REPLACED"));
+            return;
+        }
+        org.telegram.messenger.televim.PrivateReadingPolicy.Conversation captured = request.policyToken.conversation;
+        org.telegram.messenger.televim.PrivateReadingPolicy.Conversation current = request.owner.conversation(
+                captured.dialogId, captured.rootId, captured.subpeerId);
+        if (current == null) {
+            completePrivateReadingRequest(request, null, privateReadingError(401,
+                    "PRIVATE_READING_ACCOUNT_REPLACED"));
+            return;
+        }
+        listen(request.nativeToken, (response, errorCode, errorText, networkType, timestamp, requestMsgId, dcId) -> {
+            TLObject result = null;
+            TLRPC.TL_error error = null;
+            try {
+                if (response != 0) {
+                    NativeByteBuffer buffer = NativeByteBuffer.wrap(response);
+                    buffer.setDataSourceType(TLDataSourceType.NETWORK);
+                    buffer.reused = true;
+                    int magic = buffer.readInt32(true);
+                    result = request.affectedMessages
+                            ? TLRPC.TL_messages_affectedMessages.TLdeserialize(buffer, magic, true)
+                            : TLRPC.Bool.TLdeserialize(buffer, magic, true);
+                    if (result != null) {
+                        result.networkType = networkType;
+                    } else {
+                        error = privateReadingError(500, "PRIVATE_READING_RESPONSE_FAILED");
+                    }
+                } else {
+                    error = privateReadingError(errorCode, errorText == null
+                            ? "PRIVATE_READING_EMPTY_RESPONSE" : errorText);
+                }
+            } catch (Throwable exception) {
+                error = privateReadingError(500, "PRIVATE_READING_RESPONSE_FAILED");
+                if (BuildVars.LOGS_ENABLED) {
+                    FileLog.e(exception);
+                }
+            }
+            final TLObject finalResult = result;
+            final TLRPC.TL_error finalError = error;
+            Utilities.stageQueue.postRunnable(() -> {
+                if (request.owner.account() != currentAccount || !request.owner.isCurrent()) {
+                    if (finalResult != null) {
+                        finalResult.freeResources();
+                    }
+                    completePrivateReadingRequest(request, null, privateReadingError(401,
+                            "PRIVATE_READING_ACCOUNT_REPLACED"));
+                    return;
+                }
+                completePrivateReadingRequest(request, finalResult, finalError);
+            });
+        }, null, null);
+        TLRPC.TL_error handoffError = null;
+        Throwable handoffException = null;
+        synchronized (request.owner.policy()) {
+            request.owner.policy().decision(request.owner.identity(), current);
+            if (!request.owner.policy().handOff(request.owner.identity(), request.policyToken)) {
+                handoffError = privateReadingError(499, "PRIVATE_READING_POLICY_CHANGED");
+            } else {
+                try {
+                    request.handedOff = true;
+                    native_sendRequest(currentAccount, request.payload.address, 0, DEFAULT_DATACENTER_ID,
+                            ConnectionTypeGeneric, true, request.nativeToken, 0);
+                } catch (Throwable exception) {
+                    request.handedOff = false;
+                    handoffError = privateReadingError(500, "PRIVATE_READING_TRANSPORT_FAILED");
+                    handoffException = exception;
+                }
+            }
+        }
+        cancelPrivateReadingRequests(request.owner);
+        if (handoffError != null) {
+            requestCallbacks.remove(request.nativeToken);
+            completePrivateReadingRequest(request, null, handoffError);
+            if (handoffException != null && BuildVars.LOGS_ENABLED) {
+                FileLog.e(handoffException);
+            }
+        }
+    }
+
+    private void completePrivateReadingRequest(PrivateReadingRequest request,
+            TLObject response, TLRPC.TL_error error) {
+        if (!request.terminal.compareAndSet(false, true)) {
+            if (response != null) {
+                response.freeResources();
+            }
+            return;
+        }
+        privateReadingRequests.remove(request.nativeToken, request);
+        if (!request.handedOff && request.payloadReleased.compareAndSet(false, true)) {
+            request.payload.reuse();
+        }
+        request.owner.policy().finishRequest(request.owner.identity(), request.policyToken);
+        try {
+            if (request.completion != null) {
+                request.completion.run(response, error);
+            }
+        } catch (Throwable exception) {
+            if (BuildVars.LOGS_ENABLED) {
+                FileLog.e(exception);
+            }
+        } finally {
+            if (response != null) {
+                response.freeResources();
+            }
+        }
+    }
