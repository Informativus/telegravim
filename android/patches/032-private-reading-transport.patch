+    private static boolean privateReadingPayloadMatches(
+            org.telegram.messenger.televim.PrivateReadingController.AccountHandle owner,
+            org.telegram.messenger.televim.PrivateReadingPolicy.RequestToken token,
+            TLObject object) {
+        org.telegram.messenger.televim.PrivateReadingPolicy.Conversation conversation = token.conversation;
+        if (conversation == null || token.historyCutoff < 0) {
+            return false;
+        }
+        if (object.getClass() == TLRPC.TL_messages_readHistory.class) {
+            TLRPC.TL_messages_readHistory request = (TLRPC.TL_messages_readHistory) object;
+            return token.contentCount() == 0 && token.historyCutoff > 0
+                    && request.max_id == token.historyCutoff
+                    && privateReadingPeerMatches(request.peer, conversation.dialogId, owner.identity().userId)
+                    && conversation.rootId == 0 && conversation.subpeerId == 0;
+        } else if (object.getClass() == TLRPC.TL_channels_readHistory.class) {
+            TLRPC.TL_channels_readHistory request = (TLRPC.TL_channels_readHistory) object;
+            return token.contentCount() == 0 && token.historyCutoff > 0
+                    && request.max_id == token.historyCutoff
+                    && privateReadingChannelMatches(request.channel, conversation.dialogId)
+                    && conversation.rootId == 0 && conversation.subpeerId == 0;
+        } else if (object.getClass() == TLRPC.TL_messages_readDiscussion.class) {
+            TLRPC.TL_messages_readDiscussion request = (TLRPC.TL_messages_readDiscussion) object;
+            return token.contentCount() == 0 && token.historyCutoff > 0
+                    && request.read_max_id == token.historyCutoff
+                    && request.msg_id > 0 && conversation.rootId == request.msg_id
+                    && conversation.subpeerId == 0
+                    && privateReadingPeerMatches(request.peer, conversation.dialogId, owner.identity().userId);
+        } else if (object.getClass() == TLRPC.TL_messages_readSavedHistory.class) {
+            TLRPC.TL_messages_readSavedHistory request = (TLRPC.TL_messages_readSavedHistory) object;
+            return token.contentCount() == 0 && token.historyCutoff > 0
+                    && request.max_id == token.historyCutoff
+                    && conversation.rootId == 0 && conversation.subpeerId != 0
+                    && privateReadingPeerMatches(request.parent_peer, conversation.dialogId, owner.identity().userId)
+                    && privateReadingPeerMatches(request.peer, conversation.subpeerId, owner.identity().userId);
+        } else if (object.getClass() == TLRPC.TL_messages_readMessageContents.class) {
+            TLRPC.TL_messages_readMessageContents request = (TLRPC.TL_messages_readMessageContents) object;
+            return token.historyCutoff == 0 && privateReadingIdsMatch(request.id, token);
+        } else if (object.getClass() == TLRPC.TL_channels_readMessageContents.class) {
+            TLRPC.TL_channels_readMessageContents request = (TLRPC.TL_channels_readMessageContents) object;
+            return token.historyCutoff == 0 && privateReadingChannelMatches(request.channel, conversation.dialogId)
+                    && privateReadingIdsMatch(request.id, token);
+        }
+        return false;
+    }
+
+    private static boolean privateReadingIdsMatch(java.util.ArrayList<Integer> ids,
+            org.telegram.messenger.televim.PrivateReadingPolicy.RequestToken token) {
+        if (ids == null || ids.size() != token.contentCount() || ids.isEmpty()) {
+            return false;
+        }
+        for (int index = 0; index < ids.size(); ++index) {
+            Integer id = ids.get(index);
+            if (id == null || id != token.contentIdAt(index)) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    private static boolean privateReadingPeerMatches(TLRPC.InputPeer peer, long dialogId, long userId) {
+        if (peer != null && peer.getClass() == TLRPC.TL_inputPeerSelf.class) {
+            return dialogId == userId;
+        } else if (peer != null && peer.getClass() == TLRPC.TL_inputPeerUser.class) {
+            return dialogId > 0 && ((TLRPC.TL_inputPeerUser) peer).user_id == dialogId;
+        } else if (peer != null && peer.getClass() == TLRPC.TL_inputPeerChat.class) {
+            return dialogId < 0 && ((TLRPC.TL_inputPeerChat) peer).chat_id == -dialogId;
+        } else if (peer != null && peer.getClass() == TLRPC.TL_inputPeerChannel.class) {
+            return dialogId < 0 && ((TLRPC.TL_inputPeerChannel) peer).channel_id == -dialogId;
+        }
+        return false;
+    }
+
+    private static boolean privateReadingChannelMatches(TLRPC.InputChannel channel, long dialogId) {
+        return channel != null && channel.getClass() == TLRPC.TL_inputChannel.class
+                && dialogId < 0
+                && ((TLRPC.TL_inputChannel) channel).channel_id == -dialogId;
+    }
