+        if (object == null || owner == null || policyToken == null
+                || owner.account() != currentAccount
+                || policyToken.identity != owner.identity()) {
+            rejectUnclaimedPrivateReadingRequest(owner, policyToken, completionBlock,
+                    privateReadingError(400, "PRIVATE_READING_INVALID_REQUEST"));
+            return requestToken;
+        }
+        try {
+            if (!privateReadingPayloadMatches(owner, policyToken, object)) {
+                rejectUnclaimedPrivateReadingRequest(owner, policyToken, completionBlock,
+                        privateReadingError(400, "PRIVATE_READING_INVALID_PAYLOAD"));
+                return requestToken;
+            }
+        } catch (Exception error) {
+            rejectUnclaimedPrivateReadingRequest(owner, policyToken, completionBlock,
+                    privateReadingError(400, "PRIVATE_READING_INVALID_PAYLOAD"));
+            return requestToken;
+        }
+        if (!owner.policy().claimTransport(owner.identity(), policyToken,
+                PRIVATE_READING_MAX_PAYLOAD_BYTES)) {
+            rejectUnclaimedPrivateReadingRequest(owner, policyToken, completionBlock,
+                    privateReadingError(409, "PRIVATE_READING_TRANSPORT_CLAIM_REJECTED"));
+            return requestToken;
+        }
+        NativeByteBuffer payload = null;
+        final PrivateReadingRequest request;
+        try {
+            TLObject snapshot = snapshotPrivateReadingRequest(object, policyToken);
+            if (!privateReadingPayloadMatches(owner, policyToken, snapshot)
+                    || !org.telegram.messenger.televim.E2eChat.allowRequest(currentAccount, snapshot)) {
+                throw new IllegalArgumentException("Private reading payload changed");
+            }
+            int payloadSize = snapshot.getObjectSize();
+            if (payloadSize <= 0 || payloadSize > PRIVATE_READING_MAX_PAYLOAD_BYTES) {
+                throw new IllegalArgumentException("Private reading payload exceeds limit");
+            }
+            payload = new NativeByteBuffer(payloadSize);
+            snapshot.serializeToStream(payload);
+            if (payload.position() != payloadSize) {
+                throw new IllegalStateException("Incomplete private reading serialization");
+            }
+            boolean affectedMessages = snapshot.getClass() == TLRPC.TL_messages_readHistory.class
+                    || snapshot.getClass() == TLRPC.TL_messages_readMessageContents.class;
+            request = new PrivateReadingRequest(requestToken, affectedMessages, payload,
+                    owner, policyToken, completionBlock);
+            privateReadingRequests.put(requestToken, request);
+        } catch (Exception error) {
+            if (payload != null) {
+                payload.reuse();
+            }
