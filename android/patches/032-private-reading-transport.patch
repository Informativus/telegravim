+    private static final class PrivateReadingRequest {
+        final int nativeToken;
+        final boolean affectedMessages;
+        final NativeByteBuffer payload;
+        final org.telegram.messenger.televim.PrivateReadingController.AccountHandle owner;
+        final org.telegram.messenger.televim.PrivateReadingPolicy.RequestToken policyToken;
+        final RequestDelegate completion;
+        final AtomicBoolean terminal = new AtomicBoolean();
+        final AtomicBoolean payloadReleased = new AtomicBoolean();
+        volatile boolean handedOff;
+
+        PrivateReadingRequest(int nativeToken, boolean affectedMessages, NativeByteBuffer payload,
+                org.telegram.messenger.televim.PrivateReadingController.AccountHandle owner,
+                org.telegram.messenger.televim.PrivateReadingPolicy.RequestToken policyToken,
+                RequestDelegate completion) {
+            this.nativeToken = nativeToken;
+            this.affectedMessages = affectedMessages;
+            this.payload = payload;
+            this.owner = owner;
+            this.policyToken = policyToken;
+            this.completion = completion;
+        }
+    }
