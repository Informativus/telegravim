+    private void rejectUnclaimedPrivateReadingRequest(
+            org.telegram.messenger.televim.PrivateReadingController.AccountHandle owner,
+            org.telegram.messenger.televim.PrivateReadingPolicy.RequestToken policyToken,
+            RequestDelegate completion, TLRPC.TL_error error) {
+        if (owner == null || policyToken == null
+                || !owner.policy().finishUnclaimedRequest(owner.identity(), policyToken)) {
+            return;
+        }
+        deliverPrivateReadingCompletion(completion, error);
+    }
+
+    private void finishClaimedPrivateReadingRequest(
+            org.telegram.messenger.televim.PrivateReadingController.AccountHandle owner,
+            org.telegram.messenger.televim.PrivateReadingPolicy.RequestToken policyToken,
+            RequestDelegate completion, TLRPC.TL_error error) {
+        if (owner == null || policyToken == null
+                || !owner.policy().finishRequest(owner.identity(), policyToken)) {
+            return;
+        }
+        deliverPrivateReadingCompletion(completion, error);
+    }
+
+    private void deliverPrivateReadingCompletion(RequestDelegate completion, TLRPC.TL_error error) {
+        if (completion == null) {
+            return;
+        }
+        Utilities.stageQueue.postRunnable(() -> {
+            try {
+                completion.run(null, error);
+            } catch (Throwable exception) {
+                if (BuildVars.LOGS_ENABLED) {
+                    FileLog.e(exception);
+                }
+            }
+        });
+    }
