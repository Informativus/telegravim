+    private static TLObject snapshotPrivateReadingRequest(TLObject object,
+            org.telegram.messenger.televim.PrivateReadingPolicy.RequestToken token) {
+        if (object.getClass() == TLRPC.TL_messages_readHistory.class) {
+            TLRPC.TL_messages_readHistory source = (TLRPC.TL_messages_readHistory) object;
+            TLRPC.TL_messages_readHistory result = new TLRPC.TL_messages_readHistory();
+            result.peer = snapshotPrivateReadingPeer(source.peer);
+            result.max_id = source.max_id;
+            return result;
+        } else if (object.getClass() == TLRPC.TL_channels_readHistory.class) {
+            TLRPC.TL_channels_readHistory source = (TLRPC.TL_channels_readHistory) object;
+            TLRPC.TL_channels_readHistory result = new TLRPC.TL_channels_readHistory();
+            result.channel = snapshotPrivateReadingChannel(source.channel);
+            result.max_id = source.max_id;
+            return result;
+        } else if (object.getClass() == TLRPC.TL_messages_readDiscussion.class) {
+            TLRPC.TL_messages_readDiscussion source = (TLRPC.TL_messages_readDiscussion) object;
+            TLRPC.TL_messages_readDiscussion result = new TLRPC.TL_messages_readDiscussion();
+            result.peer = snapshotPrivateReadingPeer(source.peer);
+            result.msg_id = source.msg_id;
+            result.read_max_id = source.read_max_id;
+            return result;
+        } else if (object.getClass() == TLRPC.TL_messages_readSavedHistory.class) {
+            TLRPC.TL_messages_readSavedHistory source = (TLRPC.TL_messages_readSavedHistory) object;
+            TLRPC.TL_messages_readSavedHistory result = new TLRPC.TL_messages_readSavedHistory();
+            result.parent_peer = snapshotPrivateReadingPeer(source.parent_peer);
+            result.peer = snapshotPrivateReadingPeer(source.peer);
+            result.max_id = source.max_id;
+            return result;
+        } else if (object.getClass() == TLRPC.TL_messages_readMessageContents.class) {
+            TLRPC.TL_messages_readMessageContents source = (TLRPC.TL_messages_readMessageContents) object;
+            TLRPC.TL_messages_readMessageContents result = new TLRPC.TL_messages_readMessageContents();
+            for (int index = 0; index < token.contentCount(); ++index) {
+                result.id.add(source.id.get(index));
+            }
+            return result;
+        } else if (object.getClass() == TLRPC.TL_channels_readMessageContents.class) {
+            TLRPC.TL_channels_readMessageContents source = (TLRPC.TL_channels_readMessageContents) object;
+            TLRPC.TL_channels_readMessageContents result = new TLRPC.TL_channels_readMessageContents();
+            result.channel = snapshotPrivateReadingChannel(source.channel);
+            for (int index = 0; index < token.contentCount(); ++index) {
+                result.id.add(source.id.get(index));
+            }
+            return result;
+        }
+        throw new IllegalArgumentException("Unsupported private reading request");
+    }
+
+    private static TLRPC.InputPeer snapshotPrivateReadingPeer(TLRPC.InputPeer peer) {
+        TLRPC.InputPeer result;
+        if (peer.getClass() == TLRPC.TL_inputPeerSelf.class) {
+            result = new TLRPC.TL_inputPeerSelf();
+        } else if (peer.getClass() == TLRPC.TL_inputPeerUser.class) {
+            result = new TLRPC.TL_inputPeerUser();
+        } else if (peer.getClass() == TLRPC.TL_inputPeerChat.class) {
+            result = new TLRPC.TL_inputPeerChat();
+        } else if (peer.getClass() == TLRPC.TL_inputPeerChannel.class) {
+            result = new TLRPC.TL_inputPeerChannel();
+        } else {
+            throw new IllegalArgumentException("Unsupported private reading peer");
+        }
+        result.user_id = peer.user_id;
+        result.chat_id = peer.chat_id;
+        result.channel_id = peer.channel_id;
+        result.access_hash = peer.access_hash;
+        return result;
+    }
+
+    private static TLRPC.InputChannel snapshotPrivateReadingChannel(TLRPC.InputChannel channel) {
+        if (channel.getClass() != TLRPC.TL_inputChannel.class) {
+            throw new IllegalArgumentException("Unsupported private reading channel");
+        }
+        TLRPC.TL_inputChannel result = new TLRPC.TL_inputChannel();
+        result.channel_id = channel.channel_id;
+        result.access_hash = channel.access_hash;
+        return result;
+    }
