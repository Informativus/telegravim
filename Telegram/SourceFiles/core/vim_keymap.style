using "ui/basic.style";
using "ui/widgets/widgets.style";

vimHintMargin: 4px;
vimHintMinVisibleHeight: 24px;
vimHintGap: 3px;
vimHintPadding: size(7px, 3px);
vimHintTargetInset: 8px;
vimHintScanStep: size(24px, 18px);

vimHelpWidth: 720px;
vimHelpMaxHeight: 700px;
vimHelpKeyColumn: 184px;
vimHelpColumnGap: 24px;
vimHelpRowPadding: 12px;
vimHelpDetailGap: 4px;
vimHelpKeyPadding: 10px;
vimHelpKeyHeight: 26px;
vimHelpKeyGap: 5px;
vimHelpKeyRadius: 5px;
vimHelpKeyFont: font(12px semibold);
vimHelpNotePadding: margins(0px, 14px, 0px, 14px);
vimHelpRowTitle: FlatLabel(defaultFlatLabel) {
	minWidth: 120px;
	style: TextStyle(defaultTextStyle) {
		font: font(14px);
		lineHeight: 20px;
	}
}
vimHelpRowDetail: FlatLabel(defaultSubTextLabel) {
	minWidth: 120px;
	style: TextStyle(defaultTextStyle) {
		font: font(12px);
		lineHeight: 18px;
	}
}
vimHelpSectionTitle: FlatLabel(vimHelpRowTitle) {
	textFg: windowActiveTextFg;
	style: TextStyle(defaultTextStyle) {
		font: font(14px semibold);
		lineHeight: 22px;
	}
}

vimFocusWidth: 2px;
vimFocusInset: 3px;
vimFocusRadius: 6px;
vimFocusSliderSize: 22px;
vimStickerFocusInset: 3px;
vimStickerFocusWidth: 2px;
vimStickerFocusHalo: 1px;

vimJsonEditorHeight: 360px;
vimJsonPadding: 12px;
vimJsonGutterPadding: 8px;
vimJsonScrollWidth: 6px;
vimJsonScrollMin: 32px;
vimJsonScrollRadius: 3px;
vimJsonHeaderHeight: 36px;
vimJsonFooterHeight: 58px;
vimJsonButton: RoundButton(defaultActiveButton) {
	radius: 6px;
}
vimJsonSecondaryButton: RoundButton(defaultLightButton) {
	radius: 6px;
}
